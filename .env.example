# Token del bot (Discord Developer Portal > Applications > Bot > Token)
DISCORD_TOKEN=

# Connection string Postgres. In produzione (droplet) punta al servizio
# "postgres" sulla rete Docker interna; in locale, se non si usa il
# docker-compose, punta al tunnel SSH verso la droplet, es:
# postgresql://user:password@localhost:5432/kindling
DATABASE_URL=

LOG_LEVEL=INFO

# Solo per `docker compose up` in sviluppo locale (vedi docker-compose.yml).
# Non usate in produzione. Postgres non pubblica mai la porta sull'host,
# nemmeno con queste credenziali locali — vedi CLAUDE.md.
POSTGRES_USER=kindling
POSTGRES_PASSWORD=
POSTGRES_DB=kindling

# Salt per gli pseudonimi negli export del grafo (job/main.py export).
# Una stringa casuale lunga, generata una volta e poi MAI cambiata: cambiarla
# cambia tutti gli pseudonimi e rende gli export vecchi non piu' confrontabili
# con i nuovi. Senza questa variabile l'export pseudonimo si rifiuta di
# partire, perche' un hash di id Discord senza salt e' invertibile per forza
# bruta in pochi secondi.
KINDLING_PSEUDONYM_SALT=

# NESSUNA riga KINDLING_CODE_VERSION qui, di proposito: e' una trappola, non
# una dimenticanza. La versione del codice registrata in
# graph_snapshots.code_version e metric_runs.code_version viene dall'IMMAGINE
# Docker (Dockerfile, ARG passato da docker-compose.yml/build.args, calcolato
# da ops/kindling-deploy.sh con `git rev-parse --short HEAD`), non da questo
# file. env_file e environment vincono sempre sul valore incastonato
# nell'immagine: una riga KINDLING_CODE_VERSION= anche vuota qui
# sovrascriverebbe in silenzio il commit vero con una stringa vuota, e
# code_version tornerebbe NULL con la build riuscita e nessun errore — e' gia'
# successo una volta (07/09/2026), quando questa riga esisteva davvero.
# Se in futuro serve di nuovo un valore letto da .env, va deciso esplicitamente
# che i due meccanismi non convivano, non aggiunta qui senza pensarci.

# Connection string dell'API, con il ruolo di sola lettura kindling_api creato
# dalla migration 0010. DISTINTA da DATABASE_URL, che e' del ruolo proprietario
# usato da bot e job: usare quella qui vanificherebbe la garanzia, perche'
# l'API girerebbe con i permessi di chi le tabelle le crea.
# La password del ruolo si imposta a mano sulla droplet (ALTER ROLE ... PASSWORD)
# e non sta in nessun file committato — vedi runbook-droplet.md.
API_DATABASE_URL=

# Indirizzo dell'API letto dalla dashboard (dashboard/config.py). Nessun default
# nel codice, di proposito: e' la sola differenza tra sviluppo e produzione
# (docs/architettura/dashboard.md 1). Sulla droplet, dentro il compose, e'
# http://api:8000; in sviluppo il fixture, http://127.0.0.1:8899.
# ATTENZIONE: il servizio dashboard NON legge questo file (niente env_file nel
# compose, perche' qui ci sono DATABASE_URL e API_DATABASE_URL): la riga serve
# all'interpolazione ${KINDLING_API_BASE_URL} di docker-compose.yml.
KINDLING_API_BASE_URL=

# --- Login Discord della dashboard (docs/architettura/dashboard-fase2.md) ---
# Quattro variabili, tutte obbligatorie: senza, la dashboard rifiuta di partire
# nominando quella che manca. Come KINDLING_API_BASE_URL, il servizio dashboard
# NON legge questo file: le righe servono all'interpolazione di
# docker-compose.yml, che passa al container solo queste.
#
# Applicazione Discord: quella del bot (dashboard-fase2.md 3-ter), sezione
# OAuth2 del Developer Portal. Il client id e' pubblico.
KINDLING_DISCORD_CLIENT_ID=
# Il client secret NON entra mai in git, in una chat o in un log: va dal
# portale Discord al .env della droplet, e basta. E' una credenziale distinta
# da DISCORD_TOKEN, e si rigenera senza toccare il bot.
KINDLING_DISCORD_CLIENT_SECRET=
# Chiave di firma del cookie di sessione. Si genera sulla droplet con
#     openssl rand -hex 32
# (-hex, come le altre credenziali del progetto; minimo 32 caratteri, la
# dashboard rifiuta una chiave piu' corta). Cambiarla chiude tutte le sessioni.
KINDLING_SESSION_SECRET=
# La redirect URI registrata su Discord, esatta carattere per carattere: uno
# slash finale di differenza e Discord rifiuta il login. Decide anche se il
# cookie e' Secure: https in produzione; http e' accettato solo su localhost o
# 127.0.0.1, per lo sviluppo — altrove la dashboard rifiuta di partire.
KINDLING_OAUTH_REDIRECT_URI=
