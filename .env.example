# Token del bot (Discord Developer Portal > Applications > Bot > Token)
DISCORD_TOKEN=

# Connection string Postgres. In produzione (droplet) punta al servizio
# "postgres" sulla rete Docker interna; in locale, se non si usa il
# docker-compose, punta al tunnel SSH verso la droplet, es:
# postgresql://user:password@localhost:5432/kindling
DATABASE_URL=

LOG_LEVEL=INFO

# Solo per `docker compose up` in sviluppo locale (vedi docker-compose.yml).
# Non usate in produzione. Postgres non pubblica mai la porta sull'host,
# nemmeno con queste credenziali locali — vedi CLAUDE.md.
POSTGRES_USER=kindling
POSTGRES_PASSWORD=
POSTGRES_DB=kindling

# Salt per gli pseudonimi negli export del grafo (job/main.py export).
# Una stringa casuale lunga, generata una volta e poi MAI cambiata: cambiarla
# cambia tutti gli pseudonimi e rende gli export vecchi non piu' confrontabili
# con i nuovi. Senza questa variabile l'export pseudonimo si rifiuta di
# partire, perche' un hash di id Discord senza salt e' invertibile per forza
# bruta in pochi secondi.
KINDLING_PSEUDONYM_SALT=

# Versione del codice registrata in graph_snapshots.code_version. Sulla
# droplet la imposta il deploy; da un checkout locale il job ripiega su
# `git rev-parse --short HEAD`.
KINDLING_CODE_VERSION=
